<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Master Theme -->
    <style name="Theme.StockPro" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/se_blue</item>
    </style>

    <!-- Splash Screen Theme (Using Androidx Core SplashScreen) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/se_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.StockPro</item>
    </style>
</resources>

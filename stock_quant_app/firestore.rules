rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only collections intentionally shared with signed-in clients are readable.
    match /{collection}/{document} {
      allow read: if request.auth != null
        && collection in ["option_sentiment", "stock_scans", "live_quotes", "backtest_results"];
      allow write: if false;
    }

    // Each signed-in user can submit and read only their own scan command.
    match /commands/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["command", "timestamp", "processed"])
        && request.resource.data.command in ["stock", "stock_scan", "option", "option_scan"]
        && request.resource.data.timestamp is number
        && request.resource.data.processed == false;
      allow delete: if false;
    }


    // Manual scan state/results stay private to the account that ran the scan.
    match /users/{userId}/{path=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId}/stock_strategies/{strategyId} {
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "name", "symbol", "strategy_type", "fast_period", "slow_period",
          "rsi_threshold", "target_pct", "stop_loss_pct", "max_holding_days",
          "period", "updated_at"
        ])
        && request.resource.data.symbol is string
        && request.resource.data.strategy_type is string;
      allow delete: if false;
    }

    match /users/{userId}/stock_backtest_history/{runId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "symbol", "strategy_name", "strategy_type", "timeframe", "target_pct",
          "stop_loss_pct", "atr_multiplier", "total_trades", "wins", "losses",
          "win_rate", "total_return", "profit_factor", "max_drawdown",
          "sharpe_ratio", "sortino_ratio", "calmar_ratio", "expectancy",
          "avg_trade_return", "max_consecutive_wins", "max_consecutive_losses",
          "generated_at", "trades"
        ])
        && request.resource.data.symbol is string
        && request.resource.data.trades is list
        && request.resource.data.trades.size() <= 100;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
